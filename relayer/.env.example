# Arb Sepolia Relayer. Never commit a real key.
# Export RELAYER_PRIVATE_KEY in the process environment (Render dashboard or local shell).

RELAYER_PRIVATE_KEY=
GAS_RESCUE_SWAP_ADDRESS=0x65e712222745A8FCCbF038A90Fa75caB0867993D
TOKEN_ADDRESS=0x5649fF51123D534044aA7E6cBc8762698Ffed713
ROUTER_ADDRESS=0x680410c7f64e06EB7e80dc7B5c149f7855e225A8
FEE_TO=0x30466A210961c0C2C13AF0A9d35dfC6E8858bA9D
CHAIN_ID=421614
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PORT=8788

# Comma-separated browser origins allowed to call this Relayer.
# Add your Render URL and custom domain (https, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional extra origin (Render can inject the static site URL here).
APP_ORIGIN=

# Relayer-side pause (not the owner-only GasRescueSwap.pause()).
# Health stays HTTP 200 with paused=true. Quotes and rescues return 503 relayer_paused.
KILL_SWITCH=0
# Protects POST /v1/admin/pause and /v1/admin/unpause (header x-admin-secret or Bearer).
# Leave empty to disable admin routes (404). Never commit a real secret.
ADMIN_SECRET=
# Append-only JSONL of quote/rescue attempts (no private keys, no permit/order signatures).
DATA_DIR=./data
# After simulate-ok, retry broadcast on transient RPC / account-nonce / replacement only.
BROADCAST_MAX_ATTEMPTS=3
BROADCAST_RETRY_BASE_MS=200
