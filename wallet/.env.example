# Public Relayer origins. Leave a chain unset to use labeled Relayer dry-mock fixtures (not live).
# Arb must not reuse the Base origin — that host is a different chain.
# Production (Render): VITE_RELAYER_URL_ARB_SEPOLIA is the Relayer https origin, no trailing slash.
VITE_RELAYER_URL=
VITE_RELAYER_URL_ARB_SEPOLIA=

# Aliases still accepted: RELAYER_BASE_URL or VITE_RELAYER_BASE_URL

# Base Sepolia (84532) — real deploy. Fixtures use these addrs; quotes stay fixture-only.
# GasRescueSwap
VITE_GAS_RESCUE_ADDRESS=0x21A1ADf810e64B5bd1d530D31abA6856b8DEf688

# MockERC20Permit (tokenIn)
VITE_TOKEN_ADDRESS=0xE36c35cbF0373D77D00732f7B92dB4fB8fd37166

# Arb Sepolia (421614) — live deploy (permit2=0, F-1). Do not copy Base addresses here.
# GasRescueSwap 0x65e712222745A8FCCbF038A90Fa75caB0867993D
# MockERC20Permit GRTT 0x5649fF51123D534044aA7E6cBc8762698Ffed713
VITE_GAS_RESCUE_ADDRESS_ARB_SEPOLIA=0x65e712222745A8FCCbF038A90Fa75caB0867993D
VITE_TOKEN_ADDRESS_ARB_SEPOLIA=0x5649fF51123D534044aA7E6cBc8762698Ffed713

# Optional RPCs. Defaults are the public testnet endpoints.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
