# Public Relayer origin (no trailing path). Required for quotes and the sign path.
# Example: http://127.0.0.1:8787   or   https://your-relayer.example
RELAYER_BASE_URL=

# Deployed Base Sepolia GasRescue (from forge script / owner notes)
VITE_GAS_RESCUE_ADDRESS=

# Allowlisted EIP-2612 token — MockERC20Permit on the Scout deploy, or another 2612 ERC-20
VITE_TOKEN_ADDRESS=

# Optional. Defaults to the public Base Sepolia RPC.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
