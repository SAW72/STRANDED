# Public Relayer origin (no trailing path). The wallet POSTs {origin}/v1/quotes.
# Example: http://127.0.0.1:8787   or   https://your-relayer.example
# If unset, the wallet uses Relayer dry-mock fixtures (labeled sample / not live).
VITE_RELAYER_URL=

# Aliases still accepted: RELAYER_BASE_URL or VITE_RELAYER_BASE_URL

# Deployed StewardGasRescue / GasRescue on Base Sepolia (84532)
VITE_GAS_RESCUE_ADDRESS=

# Allowlisted EIP-2612 token on Base Sepolia — MockERC20Permit, or another 2612 ERC-20
VITE_TOKEN_ADDRESS=

# Optional Arb Sepolia (421614) overrides. Fall back to the Base Sepolia addresses if unset.
VITE_GAS_RESCUE_ADDRESS_ARB_SEPOLIA=
VITE_TOKEN_ADDRESS_ARB_SEPOLIA=

# Optional RPCs. Defaults are the public testnet endpoints.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
