{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stranded-points",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  // database_id is a placeholder. Replace it with the id printed by
  // `wrangler d1 create stranded-points`. It is an id, not a secret.
  // Do not add account_id, secrets, or RPC URLs to this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stranded-points",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
