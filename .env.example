# Copy to .env and fill locally. Never commit .env or real keys.

# Deployer / owner (hex, with or without 0x). Must not equal RELAYER_ADDRESS.
PRIVATE_KEY=

# First allowlisted relayer (hot key; pays gas). Owner ≠ relayer.
RELAYER_ADDRESS=

# --- Testnet RPCs only (no mainnet default) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional explorer keys for `forge script --verify`
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# --- GasRescueSwap (product) ---
# Set WETH_ADDRESS explicitly per chain. Do not use mainnet WETH.
# Base Sepolia (84532):  0x4200000000000000000000000000000000000006
# Arb Sepolia  (421614): 0x980B62Da83eFf3D4576C647993b0c1D7faf17c73
WETH_ADDRESS=
ROUTER_ADDRESS=
PERMIT2_ADDRESS=
PERMIT2_ENABLED=false

GAS_RESCUE_SWAP_ADDRESS=

# --- script/RescueSwap.s.sol demo (test keys, testnet only) ---
USER_PRIVATE_KEY=
TOKEN_ADDRESS=
ORDER_AMOUNT_IN=
ORDER_FEE_AMOUNT=
ORDER_FEE_TO=
ORDER_AMOUNT_SWAP=
ORDER_MIN_AMOUNT_OUT=
ORDER_TO=
ORDER_NATIVE_TO=
ORDER_ROUTER=
ORDER_SWAP_DATA=
ORDER_DEADLINE=
ORDER_NONCE=

# --- Fee-skim harness (GasRescue.sol) regression only ---
GAS_RESCUE_ADDRESS=
ORDER_AMOUNT=
