# Copy to .env and fill locally. Never commit .env or real keys.

# Deployer / owner (hex, with or without 0x)
PRIVATE_KEY=

# First allowlisted relayer (address the relayer will send txs from)
RELAYER_ADDRESS=

# Public Base Sepolia RPC (or your provider URL)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Basescan key for `forge script --verify`
ETHERSCAN_API_KEY=

# --- script/Rescue.s.sol demo only (test keys, Base Sepolia) ---
USER_PRIVATE_KEY=
GAS_RESCUE_ADDRESS=
TOKEN_ADDRESS=
ORDER_AMOUNT=
ORDER_FEE=
ORDER_RECIPIENT=
ORDER_DEADLINE=
ORDER_NONCE=
